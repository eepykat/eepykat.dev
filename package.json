{
	"name": "eepykat.dev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
